# 0 = auto-detect a single monitor. Positive values select a Linux I2C bus
# or the Windows monitor index printed by `dellkvm detect`.
bus = 0

# Supported languages: en, ru, fr, de, zh.
language = "en"

[[inputs]]
id = "tb"
name = "Thunderbolt / USB-C"
code = "0x19"

[[inputs]]
id = "dp"
name = "DisplayPort"
code = "0x0f"

[[inputs]]
id = "hdmi"
name = "HDMI"
code = "0x11"
